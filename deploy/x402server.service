[Unit]
Description=Wallet Radar x402 payment server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/mnt/storage/projects/wallet-radar
EnvironmentFile=-/mnt/storage/projects/wallet-radar/radar.env
ExecStart=/usr/bin/node dist/src/x402server.js
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
