{
  "name": "wallet-radar",
  "version": "0.1.0",
  "description": "Continuous wallet monitoring for Solana: baseline, diff, anomaly detection, LLM digest, alerts.",
  "type": "module",
  "main": "./dist/src/sdk/index.js",
  "types": "./dist/src/sdk/index.d.ts",
  "exports": {
    ".": "./dist/src/sdk/index.js",
    "./sdk": "./dist/src/sdk/index.js",
    "./blink": "./dist/src/blink/index.js",
    "./oracle": "./dist/src/oracle/index.js",
    "./dashboard": "./dist/src/dashboard.js",
    "./hook": "./dist/src/hook/index.js",
    "./trust-proof": "./dist/src/trust-proof.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcp-server": "./bin/mcp-server",
    "wallet-radar-mcp": "./bin/mcp-server",
    "x402-server": "./bin/x402-server",
    "wallet-radar-x402": "./bin/x402-server",
    "http-server": "./bin/http-server"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-force-exit \"dist/test/**/*.test.js\"",
    "radar": "node dist/src/cli.js",
    "mcp": "node dist/src/mcp.js",
    "mcp:server": "node dist/src/mcp-server.js",
    "x402:server": "node dist/src/x402server.js",
    "http": "node dist/src/http-server.js",
    "canary": "node dist/scripts/canary-agent.js",
    "hook:devnet": "node dist/scripts/transfer-hook-devnet.js",
    "digest": "node dist/scripts/daily-digest.js",
    "history-machine": "node dist/scripts/history-machine.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@lightprotocol/stateless.js": "^0.23.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@solana/actions": "^1.6.6",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "zod": "^4.5.4"
  }
}
